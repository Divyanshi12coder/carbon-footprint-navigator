# Used by docker-compose.yml. Copy to .env and change values — never commit .env.
POSTGRES_DB=cfn
POSTGRES_USER=cfn
POSTGRES_PASSWORD=change_me_local_password
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# "demo" = deterministic, data-grounded answers. "anthropic" + AI_API_KEY = live LLM explanations.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=claude-opus-5-5
SEED_DEMO_DATA=true
