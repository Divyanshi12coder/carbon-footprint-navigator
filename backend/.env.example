# Copy to backend/.env for local (non-Docker) runs. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cfn:change_me@localhost:5432/cfn
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
# AI assistant: "anthropic" with an API key for LLM mode, or "demo" for deterministic data-grounded answers.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=claude-opus-5-5
SEED_EMISSION_FACTORS=true
SEED_DEMO_DATA=false
DEMO_USER_EMAIL=demo@carbonnavigator.app
DEMO_USER_PASSWORD=DemoPass123!
